rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /workspaces/{workspaceId} {
      // L'application utilise Firebase Authentication anonyme.
      // Le code d'équipe doit rester confidentiel : il sert d'identifiant
      // d'espace de travail, pas de mot de passe cryptographique.
      allow read, write: if request.auth != null;

      match /{subcollection}/{documentId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
